#![enable(implicit_some)]
#![enable(unwrap_newtypes)]
#![enable(unwrap_variant_newtypes)]
(
    background_color: None,
    default_album_art_path: None,
    header_background_color: None,
    modal_background_color: None,
    modal_backdrop: false,
    format_tag_separator: " | ",
    multiple_tag_resolution_strategy: All,
    text_color: None,
    browser_column_widths: [20, 35, 45],
    scrollbar: None,
    song_table_album_separator: None,

    preview_label_style: (fg: "{{colors.tertiary.default.hex}}"),
    preview_metadata_group_style: (fg: "{{colors.tertiary.default.hex}}", modifiers: "Bold"),
    highlighted_item_style: (fg: "{{colors.primary.default.hex}}", modifiers: "Bold"),
    current_item_style: (fg: "{{colors.on_primary.default.hex}}", bg: "{{colors.primary.default.hex}}"),
    borders_style: (fg: "{{colors.primary.default.hex}}"),
    highlight_border_style: (fg: "{{colors.tertiary.default.hex}}"),

    symbols: (
        song: "",
        dir: "",
        playlist: "󰲹",
        marker: "",
        ellipsis: "..",
        song_style: None,
        dir_style: None,
        playlist_style: None,
    ),

    cava: (
        bar_width: 2,
        bar_spacing: 1,
        orientation: Bottom,
        bar_color: Single("{{colors.primary.default.hex}}"),
    ),

    tab_bar: (
        active_style: (fg: "{{colors.on_primary.default.hex}}", bg: "{{colors.primary.default.hex}}"),
        inactive_style: (fg: "{{colors.on_surface.default.hex}}"),
        separator: " | ",
    ),

    progress_bar: (
        symbols: ["", "█", "", "█", "" ],
        track_style: (fg: "{{colors.surface_variant.default.hex}}"),
        elapsed_style: (fg: "{{colors.primary.default.hex}}"),
        thumb_style: (fg: "{{colors.primary.default.hex}}", bg: "{{colors.surface_dim.default.hex}}"),
        use_track_when_empty: false,
    ),

    browser_song_format: [
        (
            kind: Property(Other("name")),
            default: (
                kind: Group([
                    (kind: Property(Artist)),
                    (kind: Text(" - ")),
                    (kind: Property(Title)),
                ]),
                default: (kind: Property(Filename))
            ),
        )
    ],

    level_styles: (
        info: (fg: "{{colors.primary.default.hex}}", bg: "{{colors.surface_dim.default.hex}}"),
        warn: (fg: "{{colors.tertiary.default.hex}}", bg: "{{colors.surface_dim.default.hex}}"),
        error: (fg: "{{colors.error.default.hex}}", bg: "{{colors.surface_dim.default.hex}}"),
        debug: (fg: "{{colors.tertiary_fixed_dim.default.hex}}", bg: "{{colors.surface_dim.default.hex}}"),
        trace: (fg: "{{colors.secondary_fixed_dim.default.hex}}", bg: "{{colors.surface_dim.default.hex}}"),
    ),

    song_table_format: [
        (
            prop: (kind: Property(Artist), default: (kind: Text("Desconocido"))),
            label_prop: (kind: Text("Artista")),
            width: "20%",
        ),
        (
            prop: (kind: Property(Title), default: (kind: Text("Desconocido"))),
            label_prop: (kind: Text("Título")),
            width: "50%",
        ),
        (
            prop: (kind: Property(Album), default: (kind: Text("Desconocido"))),
            label_prop: (kind: Text("Álbum")),
            width: "30%",
        ),
        (
            prop: (kind: Property(Duration), default: (kind: Text("0:00"))),
            label_prop: (kind: Text("Duración")),
            width: "4",
            alignment: Left,
        ),
    ],

    components: {
        "state": Pane(Property(
            content: [
                (kind: Text(" ")),
                (kind: Text("["), style: (fg: "{{colors.tertiary.default.hex}}")),
                (kind: Property(Status(StateV2())), style: (fg: "{{colors.tertiary.default.hex}}")),
                (kind: Text("]"), style: (fg: "{{colors.tertiary.default.hex}}")),
            ], align: Left,
        )),

       "title": Pane(Property(
            content: [
                (kind: Property(Song(Title)), style: (fg: "{{colors.primary.default.hex}}", modifiers: "Bold"),
                    default: (kind: Property(Song(Filename)), style: (fg: "{{colors.primary.default.hex}}", modifiers: "Bold")))
            ], align: Center, scroll_speed: 1
        )),

        "volume": Split(
            direction: Horizontal,
            panes: [
                (size: "1", pane: Pane(Empty())),
                (size: "100%", pane: Pane(Volume(kind: Slider(symbols: (filled: "─", thumb: "●", track: "─"))))),
                (size: "3", pane: Pane(Property(content: [(kind: Property(Status(Volume)), style: (fg: "{{colors.primary.default.hex}}"))], align: Right))),
                (size: "1", pane: Pane(Property(content: [(kind: Text("%"), style: (fg: "{{colors.primary.default.hex}}"))]))),
                (size: "1", pane: Pane(Empty())),
            ]
        ),

        "elapsed_and_bitrate": Pane(Property(
            content: [
                (kind: Text(" ")),
                (kind: Property(Status(Elapsed))),
                (kind: Text(" / ")),
                (kind: Property(Status(Duration))),
                (kind: Group([
                    (kind: Text(" (")),
                    (kind: Property(Status(Bitrate))),
                    (kind: Text(" kbps)")),
                ])),
            ], align: Left, scroll_speed: 1
        )),

        "artist_title": Pane(Property(
            content: [
                (kind: Property(Song(Artist)), style: (fg: "{{colors.tertiary.default.hex}}"), default: (kind: Text("Artista desconocido"), style: (fg: "{{colors.tertiary.default.hex}}"))),
                (kind: Text(" - ")),
                (kind: Property(Song(Title)), style: (fg: "{{colors.tertiary.default.hex}}"), default: (kind: Text("Título desconocido"),  style: (fg: "{{colors.tertiary.default.hex}}"))),
            ], align: Center, scroll_speed: 1
        )),

        "states": Pane(Property(
            content: [
                (kind: Property(Status(RepeatV2(
                    on_label: "󰑖 ", off_label: "󰑖 ",
                    on_style: (fg: "{{colors.tertiary.default.hex}}"), off_style: (fg: "{{colors.primary.default.hex}}"),
                )))),
                (kind: Text(" ")),
                (kind: Property(Status(RandomV2(
                    on_label: "󰒝 ", off_label: "󰒝 ",
                    on_style: (fg: "{{colors.tertiary.default.hex}}"), off_style: (fg: "{{colors.primary.default.hex}}"),
                )))),
                (kind: Text(" ")),
                (kind: Property(Status(SingleV2(
                    on_label: "󰑘 ", off_label: "󰑘 ", oneshot_label: "󰑘 ",
                    on_style: (fg: "{{colors.tertiary.default.hex}}"), off_style: (fg: "{{colors.primary.default.hex}}"), oneshot_style: (fg: "{{colors.error.default.hex}}"),
                )))),
                (kind: Text(" ")),
                (kind: Property(Status(ConsumeV2(
                    on_label: "󰮯 ", off_label: "󰮯 ", oneshot_label: "󰮯 ",
                    on_style: (fg: "{{colors.tertiary.default.hex}}"), off_style: (fg: "{{colors.primary.default.hex}}"), oneshot_style: (fg: "{{colors.error.default.hex}}"),
                )))),
            ], align: Right
        )),

        "top_row": Split(
            direction: Horizontal,
            panes: [
                (size: "25", pane: Component("state")),
                (size: "100%", borders: "LEFT | RIGHT", pane: Component("title")),
                (size: "25", pane: Component("volume")),
            ],
        ),
        "bottom_row": Split(
            direction: Horizontal,
            panes: [
                (size: "25", pane: Component("elapsed_and_bitrate")),
                (size: "100%", borders: "LEFT | RIGHT", pane: Component("artist_title")),
                (size: "25", pane: Component("states")),
            ],
        ),
        "header": Split(
            direction: Vertical,
            panes: [
                (size: "1", direction: Vertical, pane: Component("top_row")),
                (size: "1", direction: Vertical, pane: Component("bottom_row")),
            ]
        ),

        "progress_bar": Split(
            direction: Horizontal,
            panes: [
                (
                    pane: Pane(Property(content: [(kind: Property(Status(StateV2(
                        playing_label: "󰐊 ", paused_label: "󰏤 ", stopped_label: "󰓛 ",
                        playing_style: (fg: "{{colors.primary.default.hex}}"), paused_style: (fg: "{{colors.tertiary_fixed_dim.default.hex}}"), stopped_style: (fg: "{{colors.tertiary.default.hex}}")
                    ))))], align: Left)),
                    size: "3",
                ),
                (size: "100%", pane: Pane(ProgressBar)),
                (
                    size: "13",
                    pane: Pane(Property(
                        content: [
                            (kind: Property(Status(Elapsed))),
                            (kind: Text(" / ")),
                            (kind: Property(Status(Duration))),
                        ], align: Right,
                    )),
                ),
            ]
        ),
    },

    layout: Split(
        direction: Vertical,
        panes: [
            (
                size: "4",
                borders: "ALL",
                border_symbols: Inherited(parent: Plain),
                pane: Component("header"),
            ),
            (
                size: "3",
                borders: "ALL",
                border_symbols: Inherited(parent: Plain),
                pane: Pane(Tabs),
            ),
            (
                size: "100%",
                borders: "ALL",
                border_symbols: Inherited(parent: Plain),
                pane: Pane(TabContent),
            ),
            (
                size: "3",
                borders: "ALL",
                border_symbols: Inherited(parent: Plain),
                pane: Component("progress_bar"),
            ),
        ]
    ),
)
