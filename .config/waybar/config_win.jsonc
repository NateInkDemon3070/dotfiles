{
    "layer": "bottom",
    "position": "bottom",
    "height": 38,
    "margin-bottom": 0,
    "margin-left": 0,
    "margin-right": 0,
    "spacing": 0,

    "modules-center": [
        "sway/workspaces"
    ],
    "modules-right": [
        "cpu",
        "memory",
        "custom/notification",
        "tray",
        "pulseaudio",
        "bluetooth",
        "network",
        "battery",
        "clock"
    ],

    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{name}",
        "on-click": "activate"
    },

    "cpu": { "format": "󰍛 {usage}%" },
    "memory": { "format": "󰾆 {percentage}%" },
    "clock": { "format": " {:%I:%M %p}" },
    "tray": { "icon-size": 18, "spacing": 10 },
    "custom/notification": {
        "format": "{icon}",
        "return-type": "json",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw"
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-icons": { "default": ["", "", ""] },
        "on-click": "/home/jpablo/.config/sway/scripts/launch-float.sh pavucontrol"
    },
    "bluetooth": { "format": "",         "on-click": "/home/jpablo/.config/sway/scripts/launch-float.sh blueman-manager" },
    "network": { "format-wifi": "", "format-ethernet": "󰈀", "format-disconnected": "󰖪",         "on-click": "/home/jpablo/.config/sway/scripts/launch-float.sh kitty -e nmtui" },
    "battery": {
        "format": "{icon} {capacity}%",
        "format-charging": "{icon} {capacity}%",
        "format-icons": {
            "default": ["", "", "", "", ""],
            "charging": ["󰢜", "󰂆", "󰂇", "󰂈", "󰂅"]
        }
    }
}
