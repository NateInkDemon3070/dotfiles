{
  "modules": [
    "title",
    "separator",
    { "key": "   OS",       "type": "os" },
    { "key": "  󰛸 Kernel",   "type": "kernel" },
    { "key": "  󰏗 Packages", "type": "packages" },
    { "key": "  󰍹 Display",  "type": "display" },
    { "key": "  󰖲 WM",       "type": "wm" },
    { "key": "  󰆍 Shell",    "type": "shell" },
    { "key": "  󰻐 CPU",      "type": "cpu" },
    { "key": "  󰍛 GPU",      "type": "gpu" },
    {
      "type": "memory",
      "key": "  󰘚 RAM",
      "percent": { "type": ["bar", "bar-monochrome"] }
    },
    { "key": "  󰋊 Disk",     "type": "disk" },
    "break",
    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 12,
      "circle": {
        "radius": 30,
        "width": 5,
        "range": [
          0,
          15
        ]
      }
    }
  ],
  "logo": {
    "source": "~/.config/fastfetch/artix_small.ascii",
    "type": "file",
    "width": 28,
    "color": {
      "1-2": "#b0c6ff",
      "3-4": "#b8c6ed",
      "5-6": "#fabc48",
      "7-8": "#2c59ad",
      "9-13": "#7a5500"
    },
    "padding": {
      "top": 0,
      "left": 2,
      "right": 4
    }
  },
  "display": {
    "color": {
      "keys": "#b0c6ff",
      "title": "#e2e2e9",
      "separator": "#8d909d"
    },
    "bar": {
      "border": {
        "left": "\uee00",
        "leftElapsed": "\uee03",
        "right": "\uee02",
        "rightElapsed": "\uee05"
      },
      "char": {
        "total": "\uee01",
        "elapsed": "\uee04"
      },
      "color": {
        "total": null
      }
    }
  }
}
