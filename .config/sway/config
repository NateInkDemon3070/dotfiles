set $mod Mod4
set $term kitty
set $menu rofi -show drun

output * resolution 1366x768 scale 1

# --INPUT DEL TECLADO --

input "type:keyboard" {
    xkb_layout us
    xkb_variant intl
    xkb_options lv3:lalt_switch
}

input "type:touchpad" {
    tap enabled
    natural_scroll disabled
}

# -- PERSONALIZACIÓN DEL SISTEMA --
default_border pixel 2
hide_edge_borders none
gaps inner 2
gaps outer 4

corner_radius 0
blur enable
blur_passes 2
blur_radius 5
shadows enable
shadow_blur_radius 4
shadow_color #1a1a1aee

layer_effects "rofi" {
    blur enable;
    blur_xray disable;
    blur_ignore_transparent enable;
}

layer_effects "eww-music" {
    blur enable;
    blur_xray disable;
    blur_ignore_transparent enable;
}

layer_effects "swaync-control-center" {
    blur enable;
    blur_xray disable;
    blur_ignore_transparent enable;
}

layer_effects "swaync-notification-window" {
    blur enable;
    blur_xray disable;
    blur_ignore_transparent enable;
}

seat * xcursor_theme Miku-VSThemesORG 22

# --COSAS QUE SE EJECUTAN AL INICIO--
exec bash /home/jpablo/.config/sway/scripts/autostart.sh
exec runsvdir /home/jpablo/.config/runit/sv
exec bash /home/jpablo/.config/sway/scripts/sway-config-watcher.sh
seat seat0 xcursor_theme Miku-VSThemesORG 22

for_window [app_id="floating_tui"] floating enable, resize set 700 500, move position center
for_window [app_id="pavucontrol"] floating enable, resize set 800 600, move position center
for_window [app_id="blueman-manager"] floating enable, resize set 600 400, move position center
for_window [app_id="librewolf" title="LibreWolf - Choose User Profile"] floating enable, resize set 600 450, move position center
for_window [app_id="zapzap"] opacity 0.85, blur enable
for_window [app_id="thunar"] opacity 0.85, blur enable
for_window [app_id="librewolf"] opacity 0.85, blur enable
for_window [app_id="com.github.th-ch.youtube-music"] opacity 0.85, blur enable
for_window [app_id="vesktop"] opacity 0.85, blur enable

# --- KEYBINDS ---

# --- GENERALES ---
bindsym $mod+Return exec $term
bindsym $mod+q kill
bindsym $mod+e exec $term -e yazi
bindsym $mod+b exec librewolf
bindsym $mod+m exec $term -e rmpc
bindsym $mod+n exec eww open music-widget --toggle
bindsym $mod+t floating toggle
bindsym $mod+d exec $menu
bindsym $mod+f fullscreen toggle
bindsym $mod+c reload
bindsym $mod+Escape exec bash ~/.config/sway/scripts/powermenu.sh
bindsym $mod+Shift+e exec $term -e doas yazi

bindsym $mod+period exec rofimoji --action copy --selector rofi --selector-args "-theme ~/.config/rofi/config.rasi"
bindsym $mod+w exec sh /home/jpablo/.config/sway/scripts/wallpaper.sh
bindsym $mod+Shift+w exec bash /home/jpablo/.config/sway/scripts/wallpaper_select.sh
bindsym $mod+o exec bash /home/jpablo/.config/waybar/scripts/switch_waybar.sh
bindsym $mod+v exec cliphist list | rofi -dmenu -p "Portapapeles" -theme ~/.config/rofi/config.rasi | cliphist decode | wl-copy

# -- LABURO --
bindsym Ctrl+Alt+Shift+$mod+l exec zen-browser https://linkedin.com

# -- WORKSPACES --
bindsym $mod+Left focus left
bindsym $mod+Right focus right
bindsym $mod+Up focus up
bindsym $mod+Down focus down

bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Right move right
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Down move down

bindsym $mod+Ctrl+Left move left
bindsym $mod+Ctrl+Right move right
bindsym $mod+Ctrl+Up move up
bindsym $mod+Ctrl+Down move down

bindsym $mod+r mode resize
mode resize {
    bindsym Left resize shrink width 10 px or 10 ppt
    bindsym Right resize grow width 10 px or 10 ppt
    bindsym Up resize shrink height 10 px or 10 ppt
    bindsym Down resize grow height 10 px or 10 ppt
    bindsym Return mode default
    bindsym Escape mode default
    bindsym $mod+r mode default
}

bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5

bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5

floating_modifier $mod normal

# -- CONTROL DE VOLUMEN --
bindsym XF86AudioRaiseVolume exec /home/jpablo/.local/bin/swayosd-client --output-volume raise && pkill -RTMIN+1 waybar
bindsym XF86AudioLowerVolume exec /home/jpablo/.local/bin/swayosd-client --output-volume lower && pkill -RTMIN+1 waybar
bindsym XF86AudioMute exec /home/jpablo/.local/bin/swayosd-client --output-volume mute-toggle && pkill -RTMIN+1 waybar
bindsym XF86AudioMicMute exec /home/jpablo/.local/bin/swayosd-client --input-volume mute-toggle && pkill -RTMIN+1 waybar
bindsym XF86MonBrightnessUp exec /home/jpablo/.local/bin/swayosd-client --brightness raise && pkill -RTMIN+1 waybar
bindsym XF86MonBrightnessDown exec /home/jpablo/.local/bin/swayosd-client --brightness lower && pkill -RTMIN+1 waybar

# -- CAPTURAS DE PANTALLA --
bindsym Print exec flameshot full -p /home/jpablo/Imagenes/Capturas/
bindsym Mod4+Print exec flameshot full -c
bindsym Shift+Print exec flameshot gui -p /home/jpablo/Imagenes/Capturas
bindsym Mod4+Shift+Print exec flameshot gui -c
bindsym Mod4+Control+Print exec flameshot gui -p /home/jpablo/Imagenes/Capturas -d 500

# -- COLORES DE MATUGEN --
include ~/.cache/wal/colors-sway-border

# -- Modo juego para mayor rendimiento --
include ~/.config/sway/gamemode.conf
