# lf dotfiles config

set hiddenfiles ".*"
set icons on
set previewer ~/.config/lf/previewer

# dotfiles: agrega el archivo seleccionado al bare repo
cmd dotfiles-add %{{
    files="$fx"
    if [ -z "$files" ]; then
        files="$f"
    fi
    for file in $files; do
        rel="${PWD#$HOME/}"
        if [ "$rel" = "$PWD" ]; then
            continue
        fi
        git --git-dir="$HOME/.dotfiles" --work-tree="$HOME" add "$rel/$file"
        echo "added: $rel/$file"
    done
}}

# dotfiles-status: muestra el estado del repo
cmd dotfiles-status %{{
    git --git-dir="$HOME/.dotfiles" --work-tree="$HOME" status --short
    read -p "Presiona Enter para continuar..."
    lf -remote "send $id reload"
}}

cmd dotfiles-commit %{{
    read -p "Mensaje de commit: " msg
    if [ -n "$msg" ]; then
        git --git-dir="$HOME/.dotfiles" --work-tree="$HOME" commit -m "$msg" && \
        git --git-dir="$HOME/.dotfiles" --work-tree="$HOME" push
    fi
    lf -remote "send $id reload"
}}

map D dotfiles-add
map S dotfiles-status
map C dotfiles-commit

map gd :cd ~

map <c-q> quit
