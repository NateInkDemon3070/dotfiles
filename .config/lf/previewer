#!/bin/sh
case "$1" in
    *.png|*.jpg|*.jpeg|*.gif|*.bmp|*.webp)
        kitty +kitten icat --clear --transfer-mode file --place 80x24@0x0 "$1"
        ;;
    *.pdf)
        pdftotext "$1" - | head -80
        ;;
    *.zip|*.tar|*.gz|*.bz2|*.xz)
        tar tf "$1" 2>/dev/null | head -40 || unzip -l "$1" 2>/dev/null | head -40
        ;;
    *)
        bat --style=numbers --color=always "$1" 2>/dev/null || cat "$1" 2>/dev/null || echo "preview not available"
        ;;
esac
